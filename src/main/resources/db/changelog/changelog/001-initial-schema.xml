<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://liquibase.org"
        xmlns:xsi="http://w3.org"
        xsi:schemaLocation="http://liquibase.org
        http://liquibase.org/dbchangelog-latest.xsd">

    <changeSet id="1" author="artem">
        <comment>Create initial schema for canonical market ERP system</comment>

        <!-- 1. TABLE: COMPANIES -->
        <createTable tableName="companies">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="is_group" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 2. TABLE: PARTNERS -->
        <createTable tableName="partners">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="is_group" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 3. TABLE: CONTRACTS -->
        <createTable tableName="contracts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="is_group" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="contract_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_contract_company" referencedTableName="companies" referencedColumnNames="id"/>
            </column>
            <column name="partner_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_contract_partner" referencedTableName="partners" referencedColumnNames="id"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 4. TABLE: PRODUCTS -->
        <createTable tableName="products">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_id" type="BIGINT">
                <constraints foreignKeyName="fk_product_parent" referencedTableName="products" referencedColumnNames="id"/>
            </column>
            <column name="is_group" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 5. TABLE: WAREHOUSES -->
        <createTable tableName="warehouses">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_id" type="BIGINT">
                <constraints foreignKeyName="fk_warehouse_parent" referencedTableName="warehouses" referencedColumnNames="id"/>
            </column>
            <column name="is_group" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 6. TABLE: PRODUCT_CATEGORIES -->
        <createTable tableName="product_categories">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_id" type="BIGINT">
                <constraints foreignKeyName="fk_category_parent" referencedTableName="product_categories" referencedColumnNames="id"/>
            </column>
            <column name="is_group" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 7. JOIN TABLE: PRODUCT_TO_CATEGORY (ManyToMany) -->
        <createTable tableName="product_to_category">
            <column name="product_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_p2c_product" referencedTableName="products" referencedColumnNames="id"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_p2c_category" referencedTableName="product_categories" referencedColumnNames="id"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="product_to_category" columnNames="product_id, category_id" constraintName="uq_product_category"/>

        <!-- 8. TABLE: DOC_BASE (The central document table for Joined Inheritance) -->
        <createTable tableName="doc_base">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="doc_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="is_posted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 9. TABLE: DOC_INVOICES_IN (Purchases - extends doc_base) -->
        <createTable tableName="doc_invoices_in">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" foreignKeyName="fk_invoice_in_base" referencedTableName="doc_base" referencedColumnNames="id"/>
            </column>
            <column name="total_amount" type="NUMERIC(15,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 10. TABLE: DOC_INVOICE_IN_ITEMS -->
        <createTable tableName="doc_invoice_in_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="line_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_invoice_in_item" referencedTableName="doc_invoices_in" referencedColumnNames="id"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_invoice_in_prod" referencedTableName="products" referencedColumnNames="id"/>
            </column>
            <column name="quantity" type="NUMERIC(20,3)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(15,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 11. TABLE: DOC_INVOICES_OUT (Sales - extends doc_base) -->
        <createTable tableName="doc_invoices_out">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" foreignKeyName="fk_invoice_out_base" referencedTableName="doc_base" referencedColumnNames="id"/>
            </column>
            <column name="total_amount" type="NUMERIC(15,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 12. TABLE: DOC_INVOICE_OUT_ITEMS -->
        <createTable tableName="doc_invoice_out_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="line_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_invoice_out_item" referencedTableName="doc_invoices_out" referencedColumnNames="id"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_invoice_out_prod" referencedTableName="products" referencedColumnNames="id"/>
            </column>
            <column name="quantity" type="NUMERIC(20,3)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(15,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 13. TABLE: DOC_STOCK_TRANSFERS (Warehouse Transfers - extends doc_base) -->
        <createTable tableName="doc_stock_transfers">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" foreignKeyName="fk_transfer_base" referencedTableName="doc_base" referencedColumnNames="id"/>
            </column>
            <column name="source_warehouse_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_transfer_source" referencedTableName="warehouses" referencedColumnNames="id"/>
            </column>
            <column name="destination_warehouse_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_transfer_dest" referencedTableName="warehouses" referencedColumnNames="id"/>
            </column>
        </createTable>

        <!-- 14. TABLE: DOC_STOCK_TRANSFER_ITEMS -->
        <createTable tableName="doc_stock_transfer_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="line_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="transfer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_transfer_item" referencedTableName="doc_stock_transfers" referencedColumnNames="id"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_transfer_prod" referencedTableName="products" referencedColumnNames="id"/>
            </column>
            <column name="quantity" type="NUMERIC(20,3)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 15. TABLE: MOVEMENT_GOODS (Inventory Register) -->
        <createTable tableName="movement_goods">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="movement_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_mov_doc_base" referencedTableName="doc_base" referencedColumnNames="id"/>
            </column>
            <column name="line_number" type="INTEGER"/>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_mov_product" referencedTableName="products" referencedColumnNames="id"/>
            </column>
            <column name="warehouse_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_mov_warehouse" referencedTableName="warehouses" referencedColumnNames="id"/>
            </column>
            <column name="quantity" type="NUMERIC(20,3)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="movement_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>